{
  "version": "0.10.1",
  "released": "2026-10-11",
  "releases_url": "https://github.com/Mizerd/lightning/releases",
  "donate_url": "",
  "asset_url": "https://github.com/Mizerd/lightning/releases/download/v${version}/${file}",
  "packages": [
    {
      "os": "linux",
      "label": "Flathub, recommended for most users",
      "format": "Flathub",
      "store": true,
      "action": "Flathub",
      "url": "https://flathub.org/apps/org.lightning_matrix.Lightning",
      "install": "flatpak install flathub org.lightning_matrix.Lightning",
      "remove": "flatpak uninstall org.lightning_matrix.Lightning",
      "note": "Updates arrive through your software centre or flatpak update."
    },
    {
      "os": "linux",
      "label": "Any distribution, nothing installed",
      "format": "AppImage",
      "file": "Lightning-0.10.1-x86_64.AppImage",
      "install": "chmod +x Lightning-0.10.1-x86_64.*pp[Ii]mage && ./Lightning-0.10.1-x86_64.*pp[Ii]mage",
      "remove": "delete the file"
    },
    {
      "os": "linux",
      "label": "Flatpak (KDE Platform 6.11 runtime)",
      "format": ".flatpak",
      "file": "lightning_0.10.1_amd64.flatpak",
      "install": "flatpak install --user ./lightning_0.10.1_amd64.flatpak",
      "remove": "flatpak uninstall --user org.lightning_matrix.Lightning",
      "note": "Manual file: no automatic updates. Flathub is better for most people."
    },
    {
      "os": "linux",
      "label": "Debian 13+",
      "format": ".deb",
      "file": "lightning_0.10.1_amd64.deb",
      "install": "sudo apt install ./lightning_0.10.1_amd64.deb",
      "remove": "sudo apt remove lightning",
      "match": "_amd64.deb"
    },
    {
      "os": "linux",
      "label": "Ubuntu 26.04+ / Mint / Pop!_OS",
      "format": ".deb",
      "file": "lightning_0.10.1_ubuntu2604_amd64.deb",
      "match": "_ubuntu2604_amd64.deb",
      "install": "sudo apt install ./lightning_0.10.1_ubuntu2604_amd64.deb",
      "remove": "sudo apt remove lightning"
    },
    {
      "os": "linux",
      "label": "Fedora COPR, recommended for Fedora 44 and 45 (x86_64)",
      "format": "COPR",
      "store": true,
      "action": "COPR",
      "url": "https://copr.fedorainfracloud.org/coprs/mizerd/lightning-matrix/",
      "install": "sudo dnf copr enable mizerd/lightning-matrix && sudo dnf install lightning-matrix",
      "remove": "sudo dnf remove lightning-matrix",
      "note": "Updates arrive with dnf upgrade. Replaces the old lightning rpm package."
    },
    {
      "os": "linux",
      "label": "Fedora / RHEL / openSUSE",
      "format": ".rpm",
      "file": "lightning-0.10.1-1.x86_64.rpm",
      "install": "sudo dnf install ./lightning-0.10.1-1.x86_64.rpm",
      "remove": "sudo dnf remove lightning",
      "note": "Manual file: no automatic updates. On Fedora 44 or 45, use COPR above."
    },
    {
      "os": "linux",
      "label": "Snap, strict confinement, local file",
      "format": ".snap",
      "file": "lightning_0.10.1_amd64.snap",
      "install": "sudo snap install --dangerous ./lightning_0.10.1_amd64.snap",
      "remove": "sudo snap remove lightning"
    },
    {
      "os": "windows",
      "label": "MSI installer, per-user",
      "format": ".msi",
      "file": "Lightning-0.10.1-712ed6d-windows-x86_64.msi",
      "install": "double-click Lightning-0.10.1-712ed6d-windows-x86_64.msi",
      "remove": "Settings \u2192 Apps \u2192 Installed apps"
    },
    {
      "os": "windows",
      "label": "Setup EXE, per-user",
      "format": ".exe",
      "file": "Lightning-0.10.1-712ed6d-windows-x86_64-setup.exe",
      "install": "run the installer",
      "remove": "Uninstall Lightning shortcut"
    },
    {
      "os": "windows",
      "label": "Portable ZIP, installs nothing",
      "format": ".zip",
      "match": "-portable.zip",
      "file": "Lightning-0.10.1-712ed6d-windows-x86_64-portable.zip",
      "install": "extract anywhere, run Lightning.exe",
      "remove": "delete the folder"
    },
    {
      "os": "macos",
      "label": "Apple Silicon, macOS 26 or newer",
      "format": ".zip",
      "match": "-macos-arm64.zip",
      "file": "Lightning-0.10.1-712ed6d-macos-arm64.zip",
      "install": "unzip, drag Lightning.app to Applications",
      "remove": "move Lightning.app to the Bin"
    }
  ],
  "support": {
    "title": "Say hello",
    "blurb": "A chill space for anyone using Lightning or curious about it. Bugs and questions both welcome \u2014 here or in the issue tracker.",
    "alias": "#lightning:matrix.smetonis.net",
    "url": "https://matrix.to/#/%23lightning%3Amatrix.smetonis.net"
  }
}
